<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug override: `tauri android dev` loads the frontend from the dev
  machine over cleartext LAN HTTP (devUrl), whose address changes per
  network — so debug builds allow cleartext everywhere, matching the old
  usesCleartextTraffic=true debug behavior. Release uses main/res/xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
